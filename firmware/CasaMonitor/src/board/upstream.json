    "lvgl_port/lvgl_port.h": {
      "sha256": "b019e404c867864fcf54f7d9c4b9e7e3ba05d13f74e3f45dcdebe0575bcabaec",
      "change": "Switch LVGL avoid-tearing mode 3 (double-buffer direct) to mode 1 (double-buffer full refresh). RGB timing remains original 16 MHz. Diagnostic revision for left-edge text artifacts; physical verification pending."
    },
    "rgb_lcd_port/rgb_lcd_port.h": {
      "sha256": "392b2412e64c1abae4937216164f83f6fbbfa3468b5c74e832f98c6942c21029",
      "change": "Increase RGB bounce buffer from 10 to 16 lines (two internal buffers, +19200 bytes total) to allow more ISR refill latency during HTTPS. RGB pixel clock stays original 16 MHz. Sustained physical verification pending."
    },
    "lvgl_port/lvgl_port.cpp": {
      "sha256": "b51060348ad5dd60e7a784e87dbf30404a989ab6355057213de544b4e5c5a260",
      "change": "Expose LVGL heartbeat for deferred OTA boot validation; consume the complete first wake touch before delivering input to LVGL. Display timing and full-refresh mode unchanged."
    },
    "rgb_lcd_port/rgb_lcd_port.cpp": {
      "sha256": "74961f5451edce11673dfdc673e49abd67c674381cb096153b73037655291c5e",
